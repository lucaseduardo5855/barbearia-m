generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String?     @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  emailVerified DateTime?   @map("email_verified")
  image         String?
  phone         String?     @unique
  password      String?
  role          Role        @default(CLIENT)
  barbershop    Barbershop?
  barber        Barber?
  bookings      Booking[]
  accounts      Account[]
  sessions      Session[]
}

enum BarberRole {
  ADMIN
  EMPLOYEE
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Barbershop {
  id                     String                 @id @default(uuid())
  name                   String
  address                String
  phones                 String[]
  description            String
  imageUrl               String
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  bannerUrl              String?
  slug                   String?                @unique
  welcomeMessage         String?
  instagramUrl           String?
  ownerId                String?                @unique
  subscriptionActive     Boolean                @default(true)
  trialEndsAt            DateTime?
  city                   String?
  state                  String?
  openingHours           String?
  barbers                Barber[]
  owner                  User?                  @relation(fields: [ownerId], references: [id])
  services               BarbershopService[]
  subscriptionPayments   SubscriptionPayment[]
  products               Product[]
  productSales           ProductSale[]
  blockedTimes           BlockedTime[]
  transactions           FinancialTransaction[]
  communicationSettings  CommunicationSettings?
  notificationDeliveries NotificationDelivery[]
}

model SubscriptionPayment {
  id                   String     @id @default(uuid())
  barbershopId         String
  amount               Decimal    @db.Decimal(10, 2)
  paymentMethod        String     @default("PIX")
  mercadopagoPaymentId String     @unique
  status               String
  paidAt               DateTime   @default(now())
  createdAt            DateTime   @default(now())
  barbershop           Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
}

model Barber {
  id             String                 @id @default(uuid())
  name           String
  imageUrl       String
  barbershopId   String
  role           BarberRole             @default(EMPLOYEE)
  commissionRate Decimal?               @default(50) @db.Decimal(5, 2)
  userId         String?                @unique
  email          String?                @unique
  phone          String?                @unique
  barbershop     Barbershop             @relation(fields: [barbershopId], references: [id])
  user           User?                  @relation(fields: [userId], references: [id])
  bookings       Booking[]
  productSales   ProductSale[]
  blockedTimes   BlockedTime[]
  transactions   FinancialTransaction[]
}

model BarbershopService {
  id           String     @id @default(uuid())
  name         String
  description  String
  imageUrl     String
  price        Decimal    @db.Decimal(10, 2)
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])
  bookings     Booking[]
}

model Product {
  id           String        @id @default(uuid())
  name         String
  description  String?
  price        Decimal       @db.Decimal(10, 2)
  costPrice    Decimal?      @db.Decimal(10, 2)
  stock        Int           @default(0)
  minStock     Int           @default(3)
  brand        String?
  imageUrl     String?
  category     String?       @default("Geral")
  barbershopId String
  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  sales        ProductSale[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ProductSale {
  id               String     @id @default(uuid())
  barbershopId     String
  productId        String?
  productName      String
  barberId         String?
  clientName       String?
  quantity         Int        @default(1)
  unitPrice        Decimal    @db.Decimal(10, 2)
  totalAmount      Decimal    @db.Decimal(10, 2)
  commissionAmount Decimal    @default(0) @db.Decimal(10, 2)
  date             DateTime   @default(now())
  bookingId        String?
  createdAt        DateTime   @default(now())
  product          Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  barber           Barber?    @relation(fields: [barberId], references: [id], onDelete: SetNull)
  barbershop       Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
}

model BlockedTime {
  id           String     @id @default(uuid())
  barbershopId String
  barberId     String?
  date         DateTime
  reason       String?    @default("Horário Bloqueado")
  createdAt    DateTime   @default(now())
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barber       Barber?    @relation(fields: [barberId], references: [id], onDelete: SetNull)
}

model FinancialTransaction {
  id           String     @id @default(uuid())
  barbershopId String
  barberId     String?
  type         String // RECEITA | DESPESA | COMISSAO_PAGA | VALE
  category     String // Comissões | Aluguel | Produtos | Despesa Operacional | Lançamento Manual
  description  String
  amount       Decimal    @db.Decimal(10, 2)
  date         DateTime   @default(now())
  createdAt    DateTime   @default(now())
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barber       Barber?    @relation(fields: [barberId], references: [id], onDelete: SetNull)
}

model Booking {
  id                      String            @id @default(uuid())
  userId                  String
  serviceId               String
  date                    DateTime
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  paymentMethod           PaymentMethod     @default(ON_SITE)
  paymentStatus           PaymentStatus     @default(PENDING)
  status                  BookingStatus     @default(CONFIRMED)
  stripeSessionId         String?           @unique
  barberId                String?
  bookingType             String?           @default("PADRAO")
  orderNumber             String?
  extraServices           String?
  extraProducts           String?
  barberCommissionAmount  Decimal?          @db.Decimal(10, 2)
  totalPrice              Decimal?          @db.Decimal(10, 2)
  completedAt             DateTime?
  emailReminderConsent    Boolean           @default(false)
  whatsappReminderConsent Boolean           @default(false)
  marketingConsent        Boolean           @default(false)
  barber                  Barber?           @relation(fields: [barberId], references: [id])
  service                 BarbershopService @relation(fields: [serviceId], references: [id])
  user                    User              @relation(fields: [userId], references: [id])
}

model CommunicationSettings {
  barbershopId            String     @id
  emailReminderEnabled    Boolean    @default(false)
  whatsappReminderEnabled Boolean    @default(false)
  reviewWhatsappEnabled   Boolean    @default(false)
  returnWhatsappEnabled   Boolean    @default(false)
  returnAfterDays         Int        @default(30)
  barbershop              Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
}

model NotificationDelivery {
  id           String     @id @default(cuid())
  dedupeKey    String     @unique
  barbershopId String
  bookingId    String
  kind         String
  channel      String
  status       String     @default("PROCESSING")
  providerId   String?
  error        String?
  createdAt    DateTime   @default(now())
  acceptedAt   DateTime?
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId, createdAt])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  DONE
}

enum PaymentMethod {
  ON_SITE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum Role {
  CLIENT
  ADMIN
}
