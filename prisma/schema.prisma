generator client {
  provider = "prisma-client-js"
}

// Configuração do datasource para PostgreSQL, utilizando a variável de ambiente DATABASE_URL para a conexão com o banco de dados.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo de usuário
model User {
  id        String    @id @default(uuid())
  email     String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[] //Relação com as reservas feitas pelo usuário
}

// Modelo de barbearia
model Barbershop {
  id          String              @id @default(uuid())
  name        String
  address     String
  phones      String[]
  description String
  imageUrl    String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  services    BarbershopService[] //Relação com os serviços oferecidos pela barbearia
}

// Modelo de serviço oferecido pela barbearia
model BarbershopService {
  id           String     @id @default(uuid())
  name         String
  description  String
  imageUrl     String
  price        Decimal    @db.Decimal(10, 2)
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])
  bookings     Booking[] //Relação com as reservas feitas para este serviço
}

// Modelo de reserva de serviço pela barbearia
model Booking {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  serviceId String
  service   BarbershopService @relation(fields: [serviceId], references: [id])
  date      DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

